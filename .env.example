# Website
BASE_URL=https://lib.eshia.ir
START_URL=https://lib.eshia.ir/
USER_AGENT=ResearchCrawler/1.0 (respectful academic crawler)
REQUEST_TIMEOUT=30
REQUEST_DELAY=1.0
MAX_RETRIES=4
MAX_DISCOVERY_PAGES=100
MAX_PAGES_PER_VOLUME=20000
RESPECT_ROBOTS=true

# HTML selectors (may need adjustment after inspecting real pages)
CONTENT_SELECTORS=#content,.book-content,.text-content,article,main
TOC_SELECTORS=.toc,#toc,.book-index,.index-content
REMOVE_SELECTORS=header,footer,nav,script,style,iframe,.toolbar,.pagination,.advertisement,.ads

# Chunking
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=650
CHUNK_OVERLAP_TOKENS=60

# Local output only - no Elasticsearch or embedding in this version
OUTPUT_DIR=output
SQLITE_PATH=data/crawler.sqlite3

# Enable only after validating a few individual books
CRAWL_ALL_ENABLED=true
LOG_LEVEL=INFO
